#include <iostream>
#include <string>

class BankAccount {
private:
    std::string accountHolder;
    int accountNumber;
    double balance;

public:
    // Constructor to initialize account
    BankAccount(std::string name, int accNum, double initialBalance) {
        accountHolder = name;
        accountNumber = accNum;
        balance = initialBalance;
    }

    // Function to deposit money
    void deposit(double amount) {
        if (amount > 0) {
            balance += amount;
            std::cout << "Deposited: $" << amount << "\n";
        }
    }

    // Function to withdraw money
    void withdraw(double amount) {
        if (amount > 0 && amount <= balance) {
            balance -= amount;
            std::cout << "Withdrawn: $" << amount << "\n";
        } else {
            std::cout << "Insufficient balance or invalid amount!\n";
        }
    }

    // Function to display account details
    void displayStatus() {
        std::cout << "\n--- Account Details ---\n";
        std::cout << "Holder: " << accountHolder << "\n";
        std::cout << "Account Number: " << accountNumber << "\n";
        std::cout << "Current Balance: $" << balance << "\n";
    }
};

int main() {
    // Creating an object of BankAccount
    BankAccount myAccount("Alex Smith", 10123, 500.0);

    // Performing banking operations
    myAccount.displayStatus();
    myAccount.deposit(150.0);
    myAccount.withdraw(100.0);
    myAccount.displayStatus();

    return 0;
}
